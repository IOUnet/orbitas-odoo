<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_orbitas_backend_company" model="ir.rule">
        <field name="name">Orbitas backend by company</field>
        <field name="model_id" ref="model_orbitas_backend"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('orbitas_connector.group_orbitas_user'))]"/>
    </record>
