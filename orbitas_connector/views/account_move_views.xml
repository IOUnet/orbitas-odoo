<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_orbitas" model="ir.ui.view">
        <field name="name">account.move.form.orbitas</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_orbitas_binding" type="object" class="oe_stat_button" icon="fa-link" groups="orbitas_connector.group_orbitas_user" invisible="orbitas_binding_count == 0">
                    <field name="orbitas_binding_count" widget="statinfo" string="Orbitas"/>
                </button>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_orbitas_export" type="object" string="Sync Orbitas" class="btn-secondary" groups="orbitas_connector.group_orbitas_user" invisible="state != 'posted' or move_type not in ('out_invoice', 'in_invoice') or amount_residual &lt;= 0"/>
                <button name="action_orbitas_find_clearing" type="object" string="Find Clearing" class="btn-secondary" groups="orbitas_connector.group_orbitas_user" invisible="orbitas_binding_count == 0 or not orbitas_remote_obligation_id"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <group string="Orbitas" groups="orbitas_connector.group_orbitas_user" invisible="orbitas_binding_count == 0">
                    <field name="orbitas_sync_state" readonly="1"/>
                    <field name="orbitas_remote_obligation_id" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
